
#include "system.h"
#include <stdio.h>
#include <stdint.h>
#include <unistd.h>
#include <io.h>


#define READ_R 0x1
#define READ_G 0x2
#define READ_B 0x3

#define WRITE_RGB 0x4
#define WRITE_PIXEL_ADDR 0x5
#define WRITE_PIXEL_VALUE 0x6
#define WRITE_RAM_WE 0x7


#define H_RES 640
#define V_RES 480
#define PIXEL_ADDR_MAX H_RES*V_RES

#define PIXEL(x, y) ((y) * H_RES + (x))

#define DEBUT_AXE_X 50
#define FIN_AXE_X 600
#define ORIGIN_AXE_Y 400

#define COLOR(r, g, b)	(r << 6) | (g << 3) | b
#define WHITE COLOR(7, 7, 7)
#define BLACK COLOR(0, 0, 0)
#define RED COLOR(7, 0, 0)
#define GREEN COLOR(0, 7, 0)
#define BLUE COLOR(0, 0, 7)


void affiche_clean()
{
	int i;
	IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_VALUE, WHITE);
	for (i = 0; i < PIXEL_ADDR_MAX; i++)
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, i);
}


void affiche_repere()
{
	int i;

	IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_VALUE, BLACK);
	for (i = 50; i < 430; i++)
	{
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(50, i));
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(51, i));
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(52, i));

	}

	for (i = 50; i < 600; i++)
	{
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(i, ORIGIN_AXE_Y));
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(i, ORIGIN_AXE_Y+1));
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(i, ORIGIN_AXE_Y+2));
	}

}



int main()
{
  printf("Hello from Nios II!\n");

  uint8_t r_value;
  uint8_t g_value;
  uint8_t b_value;
  int indice_rg;

  int courbe_rg[FIN_AXE_X - DEBUT_AXE_X];
  int courbe_index = 0;

  IOWR(COLORIMETRIE_0_BASE, WRITE_RGB, 0);

  r_value = IORD(COLORIMETRIE_0_BASE, 0x1);
  g_value = IORD(COLORIMETRIE_0_BASE, 0x2);
  b_value = IORD(COLORIMETRIE_0_BASE, 0x3);

  printf("valeur rgb %d %d %d \n", r_value, g_value, b_value);

  IOWR(COLORIMETRIE_0_BASE, WRITE_RAM_WE, 0x1);

  affiche_clean();
  affiche_repere();

  while(1)
  {
	  r_value = IORD(COLORIMETRIE_0_BASE, 0x1);
	  g_value = IORD(COLORIMETRIE_0_BASE, 0x2);
	  b_value = IORD(COLORIMETRIE_0_BASE, 0x3);

	  printf("valeur rgb %d %d %d \n", r_value, g_value, b_value);

	  if (g_value != 0)
	  {
		  indice_rg = r_value / g_value;
		  // printf("indice rg : %d\n", indice_rg);

		  // on efface l'ancienne valeur
		  IOWR(COLORIMETRIE_0_BASE, WRITE_RAM_WE, 0x0);
		  IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_VALUE, WHITE);
		  IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(courbe_index + DEBUT_AXE_X, courbe_rg[courbe_index]));
		  IOWR(COLORIMETRIE_0_BASE, WRITE_RAM_WE, 0x1);

		  // on garde la nouvelle valeur et l'affiche
		  courbe_rg[courbe_index] = ORIGIN_AXE_Y - 10*indice_rg;
		  IOWR(COLORIMETRIE_0_BASE, WRITE_RAM_WE, 0x0);
		  IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_VALUE, RED);
		  IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(courbe_index + DEBUT_AXE_X, courbe_rg[courbe_index]));
		  IOWR(COLORIMETRIE_0_BASE, WRITE_RAM_WE, 0x1);

		  if (courbe_index >= FIN_AXE_X - DEBUT_AXE_X)
			  courbe_index = DEBUT_AXE_X;
		  else
			  courbe_index++;

	  }

	  usleep(1000000);
  }




  return 0;
}
