
#include "system.h"
#include <stdio.h>
#include <unistd.h>
#include <io.h>


#define READ_R 0x1
#define READ_G 0x2
#define READ_B 0x3

#define WRITE_RGB 0x4
#define WRITE_PIXEL_ADDR 0x5
#define WRITE_PIXEL_VALUE 0x6
#define WRITE_RAM_WE 0x7


#define H_RES 640
#define V_RES 480
#define PIXEL_ADDR_MAX H_RES*V_RES

#define PIXEL(x, y) ((y) * H_RES + (x))

#define DEBUT_AXE_X 50
#define ORIGIN_AXE_Y 240


void affiche_clean()
{
	int i;

	IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_VALUE, 0x0);

	for (i = 0; i < PIXEL_ADDR_MAX; i++)
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, i);

}

char font_0[8] = {
    0b00111100,  //   ****
    0b01000010,  //  *    *
    0b01000110,  //  *   **
    0b01001010,  //  *  * *
    0b01010010,  //  * *  *
    0b01100010,  //  **   *
    0b01000010,  //  *    *
    0b00111100   //   ****
};

void draw_char_test(char *font, int char_w, int char_h, int col, int row) {
    int x0 = col * char_w;
    int y0 = row * char_h;
    int px = 0, py = 0;

    for (py = 0; py < char_h; py++) {
        char line = font[py];
        for (px = 0; px < char_w; px++) {
            if (x0 + px >= V_RES || y0 + py >= H_RES)
                continue;
            IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(x0 + px, y0 + py));
        }
    }
}

void draw_char(char *font, int col, int row) {
    int x0 = col * 8;
    int y0 = row * 8;

    for (int py = 0; py < 8; py++) {
        char line = font[py];
        for (int px = 0; px < 8; px++) {
            if ((line >> (7 - px)) & 1) {
            	IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(x0 + px, y0 + py));
            }
        }
    }
}


void affiche_repere()
{
	int i;

	IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_VALUE, 0x1ff);
	for (i = 50; i < 430; i++)
	{
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(50, i));
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(51, i));
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(52, i));

	}

	for (i = 50; i < 600; i++)
	{
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(i, ORIGIN_AXE_Y));
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(i, ORIGIN_AXE_Y+1));
		IOWR(COLORIMETRIE_0_BASE, WRITE_PIXEL_ADDR, PIXEL(i, ORIGIN_AXE_Y+2));
	}

}





